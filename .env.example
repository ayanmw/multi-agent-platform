# Multi-Agent Platform — Environment Configuration Example
#
# Copy this file to `.env` and fill in your actual keys.
# Priority: system environment variables > .env > defaults in internal/config/config.go

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
LLM_ENDPOINT=https://aicoding.dobest.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash

# Multi-provider model discovery (JSON array). Provider name + type + endpoint/key.
# Type must match the provider implementation: "openai" (OpenAI-compatible),
# "deepseek" (OpenAI-compatible), "anthropic" (Claude Messages API), "gemini", etc.
# LLM_PROVIDERS=[{"name":"deepseek","type":"deepseek","endpoint":"https://aicoding.dobest.com/v1","api_key":"sk-xxx"}]

# Optional: explicit static model list (JSON array) overriding discovery.
# LLM_MODELS=[{"name":"deepseek-v4-flash","provider":"deepseek","endpoint":"https://aicoding.dobest.com/v1","api_key":"sk-xxx"}]
# LLM_PROVIDER_DEFAULT=deepseek

# Model tier wildcard mapping: model ID/pattern -> tier (free|efficient|lightweight|standard|premium).
# Supports "*" glob; first match wins. Examples:
# MODEL_TIER_deepseek-v4-flash=efficient
# MODEL_TIER_claude-*=premium
# MODEL_TIER_*-local=free

# Agent model selection mode. Values:
#   single_model  - always use the agent's configured Model (or LLM_MODEL default)
#   auto_route    - let the Router pick a tier/model per task based on intent
# The default when unset is single_model for backward compatibility.
# AGENT_DEFAULT_MODEL_MODE=single_model

# Provider-specific global endpoints/keys (used for anthropic/gemini defaults)
# ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1
# ANTHROPIC_API_KEY=sk-ant-xxx
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com
# GEMINI_API_KEY=AIza-xxx

# Mock mode (default true for safe local testing)
LLM_USE_MOCK=true
# LLM_REAL_CASES=case-id-1,case-id-2
# LLM_MOCK_ENDPOINTS=case-id-3

# Server
SERVER_PORT=8080
DB_PATH=data/app.db

# Auth (default off; set true to enforce API key on protected endpoints)
# REQUIRE_AUTH=true

# Logging — Phase 8-1 (log/slog 多 sink + 轮转 + 7 级)
# LOG_LEVEL=info                      # 总级别开关：trace|debug|info|warn|error|fatal|panic（缺省 info）
# LOG_CONSOLE_LEVEL=info              # 控制台级别；缺省继承 LOG_LEVEL
# LOG_FILE_LEVEL=info                 # 文件级别；缺省继承 LOG_LEVEL（可设 debug 留全量）
# LOG_FILE=logs/server.log            # 文件日志路径；显式设为空串 "" 关闭文件 sink（只写控制台）
# LOG_ADD_SOURCE=false                # 是否在日志中输出 caller=file.go:line
# LOG_MAX_SIZE_MB=100                 # 单文件大小上限（MB），达到即触发轮转
# LOG_MAX_BACKUPS=7                   # 保留的历史轮转文件数
# LOG_MAX_AGE_DAYS=30                 # 历史文件最长保留天数
# LOG_COMPRESS=false                  # 是否 gzip 压缩历史轮转文件

# ---------------------------------------------------------------------------
# Tool-specific configuration
# ---------------------------------------------------------------------------

# Web search — provider-independent local search via Exa / Parallel MCP over HTTP,
# plus no-key domestic HTML providers (Baidu mobile, Sogou, Bing China).
# DuckDuckGo fallback is disabled by default. To enable it, set WEBSEARCH_DISABLE_DDG=false.
# WEBSEARCH_PROVIDER=baidu
# WEBSEARCH_ENABLE_BAIDU=true
# WEBSEARCH_ENABLE_SOGOU=true
# WEBSEARCH_ENABLE_BING_CN_HTML=true
# WEBSEARCH_DISABLE_DDG=false
# WEBSEARCH_ENABLE_EXA=true
# WEBSEARCH_ENABLE_PARALLEL=true
# WEBSEARCH_EXA_API_KEY=your-exa-key
# WEBSEARCH_PARALLEL_API_KEY=your-parallel-key

# MCP servers (JSON array of stdio / sse transport configs)
# MCP_SERVERS=[{"name":"time","transport":"stdio","command":"node","args":["mcp/time.js"],"enabled":true}]

# MCP remote markets (JSON array of URL catalogs fetched at startup)
# MCP_MARKETS=[{"name":"opencode","url":"https://example.com/opencode-mcp-catalog.json"}]

# Docker sandboxing for execute_program (default off)
# SANDBOX_ENABLE=true
# SANDBOX_IMAGE=python:3.11-slim

# ---------------------------------------------------------------------------
# Embedding provider — optional. Leave unset to use the zero-dependency local
# TF-IDF / hashed provider. Set EMBEDDING_PROVIDER=openai or cohere plus key.
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER=openai
# EMBEDDING_ENDPOINT=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Observability (Phase 7-C)
# ---------------------------------------------------------------------------
# TRACE_BUFFER_LIMIT=2000             # 内存 trace 环形缓冲大小（think / tool:* span）
# AUDIT_BUFFER_LIMIT=10000            # 内存审计缓冲大小
# METRICS_TOKEN=                      # 为空不鉴权；设值后 /metrics 需 Bearer token
